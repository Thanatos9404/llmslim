# LLMSlim website: accounts configuration.
#
# Copy to .env.local for local development (it is git-ignored). Every value here is a placeholder.
# In Vercel, set these under Project > Settings > Environment Variables (see ACCOUNTS_SETUP.md for
# which environment each one belongs to). Nothing is required for `npm run build`: without
# DATABASE_URL the accounts API answers 503 and the pages say accounts are unavailable.

# --- Database (required for accounts) -------------------------------------------------------
# Postgres connection string used by the app at runtime. In production: the pooled Neon URL for the
# least-privilege app role. TLS is enforced for every non-loopback host.
# Local development with PGlite (npm run db:local):
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
# Direct (unpooled) owner URL, used only by `npm run db:migrate`. Never needed by the running app.
# DATABASE_URL_UNPOOLED=postgresql://neondb_owner:REPLACE_ME@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Better Auth (required in production) ---------------------------------------------------
# 32+ random bytes, different per environment. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Optional in local development (a fixed development-only secret is used when it is missing).
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET
# Public origin of the site, no trailing slash. Production: https://www.llmslim.app
# Leave unset on Vercel previews: the preview's own URL is used.
BETTER_AUTH_URL=http://localhost:3000

# --- Google sign-in (optional; the button is hidden unless both are set) ---------------------
# GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=REPLACE_ME

# --- GitHub sign-in (optional; the button is hidden unless both are set) ---------------------
# GITHUB_CLIENT_ID=REPLACE_ME
# GITHUB_CLIENT_SECRET=REPLACE_ME

# --- Email (required in production for email/password sign-up and password reset) ------------
# Without both, production disables email/password sign-up and password reset (fail closed).
# RESEND_API_KEY=re_REPLACE_ME
# AUTH_EMAIL_FROM=LLMSlim <accounts@llmslim.app>

# --- Passkeys (optional) -------------------------------------------------------------------
# Relying party ID. Defaults to llmslim.app in production (covers www and the apex) and to the
# host of BETTER_AUTH_URL elsewhere (localhost locally).
# PASSKEY_RP_ID=llmslim.app
# PASSKEY_RP_NAME=LLMSlim

# --- Development and tests only (ignored on Vercel) -----------------------------------------
# Where verification and reset emails go when Resend is not configured: "log" (the default in
# `next dev`) prints the link in the server log; "file" writes JSON files for the e2e tests.
# AUTH_DEV_MAIL=log
# AUTH_DEV_MAIL_DIR=.auth-mail
# Set to "off" to skip the Have I Been Pwned check when working offline. Always on on Vercel.
# AUTH_BREACHED_PASSWORD_CHECK=on
