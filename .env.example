# Names only. Copy to .env (gitignored) and fill in locally; never commit values.
# Every integration is off until its key is set. Each guarded integration also reads
# LLMSLIM_<PREFIX>_REQUESTS_PER_MINUTE, LLMSLIM_<PREFIX>_MAX_REQUESTS and
# LLMSLIM_<PREFIX>_MAX_UNITS; leave them empty for the defaults, or set "none" to disable one.

# --- Sarvam (llmslim[sarvam]) ---
SARVAM_API_KEY=
# Chat providers built with from_env() (units: INR)
LLMSLIM_SARVAM_CHAT_REQUESTS_PER_MINUTE=
LLMSLIM_SARVAM_CHAT_MAX_REQUESTS=
LLMSLIM_SARVAM_CHAT_MAX_UNITS=
# Language identification, transliteration and translation (units: INR)
LLMSLIM_SARVAM_TEXT_REQUESTS_PER_MINUTE=
LLMSLIM_SARVAM_TEXT_MAX_REQUESTS=
LLMSLIM_SARVAM_TEXT_MAX_UNITS=
# Document digitisation (units: INR)
LLMSLIM_SARVAM_DOCUMENT_REQUESTS_PER_MINUTE=
LLMSLIM_SARVAM_DOCUMENT_MAX_REQUESTS=
LLMSLIM_SARVAM_DOCUMENT_MAX_UNITS=
# Speech-to-text and text-to-speech in examples/sarvam_voice_agent.py (units: INR)
LLMSLIM_SARVAM_SPEECH_REQUESTS_PER_MINUTE=
LLMSLIM_SARVAM_SPEECH_MAX_REQUESTS=
LLMSLIM_SARVAM_SPEECH_MAX_UNITS=

# Hosted Sarvam service (llmslim.hosted; the Studio "Answer with Sarvam" step)
LLMSLIM_HOSTED_SARVAM_ENABLED=false
LLMSLIM_SARVAM_MODEL=sarvam-105b
LLMSLIM_SARVAM_DAILY_BUDGET_INR=
LLMSLIM_SARVAM_MONTHLY_BUDGET_INR=
LLMSLIM_SARVAM_MAX_REQUEST_COST_INR=
LLMSLIM_RATE_LIMIT_HMAC_SECRET=
LLMSLIM_ALLOWED_ORIGINS=

# --- MongoDB (llmslim[mongodb]; hosted spend ledger and context store) ---
MONGODB_URI=

# --- Exa web search source (llmslim[exa]; units: USD) ---
EXA_API_KEY=
LLMSLIM_EXA_REQUESTS_PER_MINUTE=
LLMSLIM_EXA_MAX_REQUESTS=
LLMSLIM_EXA_MAX_UNITS=

# --- Neo4j temporal memory (llmslim[neo4j]; units: Cypher statements) ---
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
LLMSLIM_NEO4J_REQUESTS_PER_MINUTE=
LLMSLIM_NEO4J_MAX_REQUESTS=
LLMSLIM_NEO4J_MAX_UNITS=

# --- Zoho sources (llmslim[zoho]) ---
ZOHO_ACCESS_TOKEN=
ZOHO_DATA_CENTER=IN

# --- Benchmarks only (never the Studio or Platform) ---
# Secondary-reader runs: python -m benchmarks.live_secondary_reader
LLMSLIM_RUN_LIVE_SARVAM=0
LLMSLIM_SARVAM_BENCH_REQUESTS_PER_MINUTE=
LLMSLIM_SARVAM_BENCH_MAX_REQUESTS=
LLMSLIM_SARVAM_BENCH_MAX_UNITS=
# Nebius has a card on file: off unless LLMSLIM_NEBIUS_ALLOW_LIVE=1, US$0.10 cap, verified price required.
LLMSLIM_NEBIUS_ALLOW_LIVE=0
NEBIUS_API_KEY=
NEBIUS_MODEL=
LLMSLIM_NEBIUS_BENCH_REQUESTS_PER_MINUTE=
LLMSLIM_NEBIUS_BENCH_MAX_REQUESTS=
LLMSLIM_NEBIUS_BENCH_MAX_UNITS=
# LangSmith tracing of public benchmark datasets only
LLMSLIM_LANGSMITH_TRACING=0
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=llmslim-benchmarks
LANGSMITH_ENDPOINT=
LLMSLIM_LANGSMITH_REQUESTS_PER_MINUTE=
LLMSLIM_LANGSMITH_MAX_REQUESTS=

# --- Website (Vercel project env; NEXT_PUBLIC_* values are public by design) ---
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_MIXPANEL_TOKEN=
NEXT_PUBLIC_MIXPANEL_API_HOST=
SENTRY_DSN=
