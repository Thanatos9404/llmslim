{
  "name": "llmslim",
  "version": "0.2.0",
  "description": "Long-term memory and context fitting for AI agents, with no LLM in the loop: the client for llmslim serve, with Vercel AI SDK and Mastra integrations.",
  "license": "MIT",
  "author": "Yashvardhan Thanvi",
  "homepage": "https://llmslim.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thanatos9404/llmslim.git",
    "directory": "clients/typescript"
  },
  "bugs": "https://github.com/Thanatos9404/llmslim/issues",
  "keywords": [
    "llm",
    "memory",
    "agents",
    "context",
    "ai-sdk",
    "mastra",
    "mem0",
    "claude",
    "openai"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk.d.ts",
      "import": "./dist/ai-sdk.js"
    },
    "./mastra": {
      "types": "./dist/mastra.d.ts",
      "import": "./dist/mastra.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.29.1 <2",
    "ai": ">=7.0.0 <8"
  },
  "peerDependenciesMeta": {
    "@mastra/core": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.29",
    "@mastra/core": "1.78.0",
    "@types/node": "22.20.5",
    "ai": "7.0.143",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "zod": "4.1.8"
  }
}
